# =============================================================================
# bpresent — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Supabase (Required)
# Get these from: https://supabase.com → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of your Supabase project (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key — used for client-side queries (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — used ONLY on the server side for admin operations.
# ⚠️  NEVER expose this to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ─────────────────────────────────────────────────────────────────────────────
# Redis (Optional — for high-performance real-time caching)
# The app works without Redis but performance will be lower under heavy load.
#
# Option A: Upstash Redis (Recommended for Vercel / serverless)
#   Get from: https://console.upstash.com → REST API
# ─────────────────────────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Option B: Standard Redis URL (for self-hosted / Railway / Render)
# Comment out Option A and uncomment this if using a standard Redis server.
# REDIS_URL=redis://localhost:6379


# ─────────────────────────────────────────────────────────────────────────────
# Poll Settings (Optional — these have sensible defaults)
# ─────────────────────────────────────────────────────────────────────────────

# How long (in hours) an authenticated user's poll stays active (default: 24)
POLL_TTL_HOURS=24

# How long (in hours) an anonymous poll stays active (default: 3)
ANONYMOUS_POLL_TTL_HOURS=3

# Number of digits in a poll join code (default: 4)
POLL_CODE_LENGTH=4


# ─────────────────────────────────────────────────────────────────────────────
# App Environment (set automatically by hosting platforms like Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV=development   ← set automatically; do not set manually
